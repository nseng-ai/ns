# Auto-sync and activate the uv-managed .venv for this worktree.
watch_file pyproject.toml uv.lock
uv sync --quiet
export VIRTUAL_ENV="$PWD/.venv"
PATH_add "$VIRTUAL_ENV/bin"

# Auto-install and expose pnpm workspace bins for this worktree.
watch_file ts/package.json ts/pnpm-lock.yaml
pnpm install --dir ts --silent
PATH_add "$PWD/ts/node_modules/.bin"
