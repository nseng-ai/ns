# Reevaluate this environment when workspace dependency declarations change.
# watch_file only marks these files as dependencies; it does not install packages.
watch_file ts/package.json ts/pnpm-lock.yaml

# Install dependencies from ts/ in a subshell so the caller's directory is unchanged.
(cd ts && pnpm install --silent)

# Prepend the package binaries installed in this worktree (each Slot has its own path).
PATH_add "$PWD/ts/node_modules/.bin"

# Herdr-created Slot panes may not inherit exports from the source tab's live shell.
# Direnv can restore machine-local development settings when a pane enters a worktree.
# This optional, untracked home-directory file keeps user-specific settings out of Git
# and means that other developers and CI do not need to create it.
source_env_if_exists "$HOME/.config/ns/dev.env"
