{
	"ns": {
		"description": "Create and load branch-scoped implementation context.",
		"group": "branch-context",
		"points": [
			{
				"path": [
					"plans-write"
				],
				"accepts": "prompt",
				"semantics": "override",
				"default": "./prompts/plans-write-default.md",
				"description": "Prompt body for saving self-contained branch-context plans."
			}
		],
		"commands": [
			{
				"path": [
					"exec",
					"from-plan"
				],
				"description": "Create branch context from a saved plan.",
				"entry": "./src/commands/from-plan.ts"
			},
			{
				"path": [
					"exec",
					"load"
				],
				"description": "Load an attached branch-context plan.",
				"entry": "./src/commands/load.ts"
			},
			{
				"path": [
					"exec",
					"attach"
				],
				"description": "Attach a saved plan or file as branch context.",
				"entry": "./src/commands/attach.ts"
			},
			{
				"path": [
					"exec",
					"list"
				],
				"description": "List branch-context entries.",
				"entry": "./src/commands/list.ts"
			},
			{
				"path": [
					"exec",
					"check"
				],
				"description": "Check a branch-context entry.",
				"entry": "./src/commands/check.ts"
			},
			{
				"path": [
					"exec",
					"delete"
				],
				"description": "Delete a branch-context entry.",
				"entry": "./src/commands/delete.ts"
			}
		]
	}
}
