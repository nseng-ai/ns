{
  "markdown": {
    "lineWidth": 100
  },
  "toml": {
    "lineWidth": 100
  },
  "includes": [
    "**/*.md",
    "**/*.toml"
  ],
  "excludes": [
    ".agents",
    ".claude",
    "node_modules",
    ".venv",
    ".pytest_cache",
    ".asdl/prompts/planned-branch-write-plan.md",
    "packages/asdl-core/src/asdl_core/prompts/defaults/planned-branch-write-plan.md"
  ],
  "plugins": [
    "https://plugins.dprint.dev/markdown-0.21.1.wasm",
    "https://plugins.dprint.dev/toml-0.7.0.wasm"
  ]
}
