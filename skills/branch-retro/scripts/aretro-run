#!/usr/bin/env bash
# Dispatch `aretro` to the TypeScript source CLI in asdl checkouts, or to an
# installed TypeScript `aretro` command on PATH.
# See docs/aretro.md.
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel 2>/dev/null || true)"
if [[ -n "$repo_root" && -f "$repo_root/ts/packages/aretro/src/cli.ts" ]]; then
  exec node --experimental-strip-types "$repo_root/ts/packages/aretro/src/cli.ts" "$@"
fi

if command -v aretro >/dev/null 2>&1; then
  exec aretro "$@"
fi

echo "aretro-run: Python aretro is retired; run from an asdl checkout or install the TypeScript shim with 'just install-aretro'." >&2
exit 127
