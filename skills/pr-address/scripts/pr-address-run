#!/usr/bin/env bash
# Dispatch `pr-address` to the local TypeScript sources in an asdl checkout or
# to the bundled self-contained JavaScript artifact for installed/prod use.
set -euo pipefail

# Frozen PyPI rollback pin. The in-repo Python package is deleted; this is the
# last published legacy Python release and the only rollback target.
ASDL_LEGACY_PYTHON_VERSION="0.1.1"

script_dir="$(dirname "$0")"
bundle_path="$script_dir/pr-address.bundle.mjs"

repo_root="$(git rev-parse --show-toplevel 2>/dev/null || true)"

run_bundle() {
  if [[ ! -f "$bundle_path" ]]; then
    echo "pr-address-run: bundled pr-address artifact is missing at $bundle_path (rebuild with: pnpm --dir ts/packages/pr-address run bundle, or set ASDL_PR_ADDRESS_MODE=legacy-python)" >&2
    exit 2
  fi
  exec node "$bundle_path" "$@"
}

run_ts_local() {
  if [[ -z "$repo_root" || ! -f "$repo_root/ts/packages/pr-address/src/cli.ts" ]]; then
    echo "pr-address-run: local TypeScript pr-address is not available in this checkout" >&2
    exit 2
  fi
  exec node "$repo_root/ts/packages/pr-address/src/cli.ts" "$@"
}

run_legacy_python_uvx() {
  exec uvx --from "asdl-pr-address==${ASDL_LEGACY_PYTHON_VERSION}" pr-address "$@"
}

case "${ASDL_PR_ADDRESS_MODE:-}" in
  local|ts-local) run_ts_local "$@" ;;
  legacy-python) run_legacy_python_uvx "$@" ;;
  prod) run_bundle "$@" ;;
  "") ;;
  *)
    echo "pr-address-run: unknown ASDL_PR_ADDRESS_MODE='${ASDL_PR_ADDRESS_MODE}' (expected one of: local, ts-local, legacy-python, prod)" >&2
    exit 2
    ;;
esac

if [[ -n "$repo_root" && -f "$repo_root/ts/packages/pr-address/src/cli.ts" ]]; then
  run_ts_local "$@"
fi

run_bundle "$@"
