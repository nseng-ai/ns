#!/usr/bin/env bash
# Dispatch `pr-address` to the local TypeScript scaffold in an asdl checkout or
# to the pinned legacy Python package for installed/prod use.
set -euo pipefail

# Temporary legacy fallback pin. Keep in sync with the TypeScript fallback until
# the Python compatibility path is retired.
ASDL_VERSION="0.1.0"

repo_root="$(git rev-parse --show-toplevel 2>/dev/null || true)"

prod_uvx() {
  exec uvx --from "asdl-pr-address==${ASDL_VERSION}" pr-address "$@"
}

run_ts_local() {
  if [[ -z "$repo_root" || ! -f "$repo_root/ts/packages/pr-address/src/cli.ts" ]]; then
    echo "pr-address-run: local TypeScript pr-address is not available in this checkout" >&2
    exit 2
  fi
  exec node "$repo_root/ts/packages/pr-address/src/cli.ts" "$@"
}

run_python_local() {
  if [[ -z "$repo_root" || ! -f "$repo_root/packages/asdl-pr-address/pyproject.toml" ]]; then
    echo "pr-address-run: local legacy Python pr-address is not available in this checkout" >&2
    exit 2
  fi
  exec uv run --project "$repo_root" pr-address "$@"
}

case "${ASDL_PR_ADDRESS_MODE:-}" in
  local|ts-local) run_ts_local "$@" ;;
  python-local|legacy-python) run_python_local "$@" ;;
  prod) prod_uvx "$@" ;;
  "") ;;
  *)
    echo "pr-address-run: unknown ASDL_PR_ADDRESS_MODE='${ASDL_PR_ADDRESS_MODE}' (expected one of: local, ts-local, python-local, legacy-python, prod)" >&2
    exit 2
    ;;
esac

if [[ -n "$repo_root" && -f "$repo_root/ts/packages/pr-address/src/cli.ts" ]]; then
  run_ts_local "$@"
fi

prod_uvx "$@"
