{
  "name": "asdl-ts-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=24.12.0",
    "pnpm": ">=11.8.0"
  },
  "scripts": {
    "check": "tsgo -p tsconfig.json",
    "deps:check": "syncpack lint",
    "deps:fix": "syncpack fix",
    "fmt": "oxfmt 'packages/**/*.ts' '*.ts'",
    "fmt:check": "oxfmt --check 'packages/**/*.ts' '*.ts'",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "test": "vitest run --config vitest.config.ts"
  },
  "devDependencies": {
    "@asdl/branch-context": "workspace:*",
    "@asdl/roaster": "workspace:*",
    "@asdl/ccc": "workspace:*",
    "@asdl/plans": "workspace:*",
    "@asdl/sdl": "workspace:*",
    "@asdl/slot": "workspace:*",
    "@types/node": "catalog:",
    "sdlcc": "workspace:*",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "@typescript/native-preview": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "syncpack": "catalog:"
  },
  "workspaces": [
    "packages/*"
  ],
  "patchedDependencies": {
    "@earendil-works/pi-ai@0.79.1": "patches/@earendil-works%2Fpi-ai@0.79.1.patch"
  }
}
