{
	"name": "ns-ts-workspace",
	"license": "MIT",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@11.8.0",
	"engines": {
		"node": ">=24.12.0",
		"pnpm": ">=11.8.0"
	},
	"scripts": {
		"check": "tsc -p tsconfig.json",
		"deps:check": "syncpack lint",
		"deps:fix": "syncpack fix",
		"fmt": "cd .. && ts/node_modules/.bin/oxfmt 'ts/packages/**/*.ts' 'ts/*.ts'",
		"fmt:check": "cd .. && ts/node_modules/.bin/oxfmt --check 'ts/packages/**/*.ts' 'ts/*.ts'",
		"lint": "cd .. && ts/node_modules/.bin/oxlint ts",
		"lint:fix": "cd .. && ts/node_modules/.bin/oxlint ts --fix",
		"release:bump-version": "ns-dev bump-public-package-version",
		"release:publish": "ns-dev publish-public-package-set publish",
		"release:publish-dry-run": "ns-dev publish-public-package-set dry-run",
		"release": "ns-dev release-public-package-set",
		"release:reset": "ns-dev reset-public-package-release",
		"release:qualify-public": "ns-dev qualify-public-package-set",
		"release:verify-public": "ns-dev verify-public-package-set",
		"test": "vitest run --config vitest.config.ts",
		"test:integration": "vitest run --config vitest.integration.config.ts",
		"test:isolated": "vitest run --config vitest.isolated.config.ts",
		"test:typescript-style-guard": "vitest run --config vitest.typescript-style-guard.config.ts"
	},
	"devDependencies": {
		"@internal/ns-dev": "workspace:*",
		"@internal/pi-tools": "workspace:*",
		"@internal/ns-pi-subagents": "workspace:*",
		"@nseng-ai/pr-feedback": "workspace:*",
		"@nseng-ai/branch-context": "workspace:*",
		"@nseng-ai/brmem": "workspace:*",
		"@nseng-ai/extension-kit": "workspace:*",
		"@nseng-ai/ns": "workspace:*",
		"@nseng-ai/foundation": "workspace:*",
		"@nseng-ai/flow": "workspace:*",
		"@nseng-ai/handoffs": "workspace:*",
		"@nseng-ai/herdr": "workspace:*",
		"@nseng-ai/sdk": "workspace:*",
		"@nseng-ai/objectives": "workspace:*",
		"@nseng-ai/plans": "workspace:*",
		"@internal/review-reinvention-scanner": "workspace:*",
		"@nseng-ai/reviews": "workspace:*",
		"@nseng-ai/slots": "workspace:*",
		"@types/node": "catalog:",
		"@typescript/native": "catalog:",
		"@withgraphite/graphite-cli": "catalog:",
		"jsonc-parser": "catalog:",
		"oxfmt": "catalog:",
		"oxlint": "catalog:",
		"syncpack": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	},
	"workspaces": [
		"packages/public/**",
		"packages/incubating/**",
		"packages/internal/**",
		"!packages/**/dist/**"
	]
}
