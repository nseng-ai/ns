{
  "name": "sdl-ts-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=24.12.0",
    "pnpm": ">=11.8.0"
  },
  "scripts": {
    "check": "tsgo -p tsconfig.json",
    "deps:check": "syncpack lint",
    "deps:fix": "syncpack fix",
    "fmt": "oxfmt 'packages/**/*.ts' '*.ts'",
    "fmt:check": "oxfmt --check 'packages/**/*.ts' '*.ts'",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "test": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "devDependencies": {
    "@sdl/autobranch": "workspace:*",
    "@sdl/branch-context": "workspace:*",
    "@sdl/brmem": "workspace:*",
    "@sdl/capability-kit": "workspace:*",
    "@sdl/ccc": "workspace:*",
    "@sdl/core": "workspace:*",
    "@sdl/graphite": "workspace:*",
    "@sdl/plans": "workspace:*",
    "@sdl/roaster": "workspace:*",
    "@sdl/sdl": "workspace:*",
    "@sdl/slot": "workspace:*",
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "@withgraphite/graphite-cli": "catalog:",
    "jsonc-parser": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "sdl-flow": "workspace:*",
    "sdlcc": "workspace:*",
    "syncpack": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "workspaces": [
    "packages/*",
    "packages/*/*"
  ],
  "patchedDependencies": {
    "@earendil-works/pi-ai@0.79.1": "patches/@earendil-works%2Fpi-ai@0.79.1.patch"
  }
}
