{
	"name": "ns-ts-workspace",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@11.8.0",
	"engines": {
		"node": ">=24.12.0",
		"pnpm": ">=11.8.0"
	},
	"scripts": {
		"check": "tsgo -p tsconfig.json",
		"deps:check": "syncpack lint",
		"deps:fix": "syncpack fix",
		"fmt": "oxfmt 'packages/**/*.ts' '*.ts'",
		"fmt:check": "oxfmt --check 'packages/**/*.ts' '*.ts'",
		"lint": "oxlint .",
		"lint:fix": "oxlint . --fix",
		"test": "vitest run --config vitest.config.ts",
		"test:integration": "vitest run --config vitest.integration.config.ts",
		"test:typescript-style-guard": "vitest run --config vitest.typescript-style-guard.config.ts"
	},
	"devDependencies": {
		"@internal/pi-tools": "workspace:*",
		"@nseng-ai/ns-pi-subagents": "workspace:*",
		"@nseng-ai/pr-feedback": "workspace:*",
		"@nseng-ai/retros": "workspace:*",
		"@nseng-ai/branch-context": "workspace:*",
		"@nseng-ai/brmem": "workspace:*",
		"@nseng-ai/capability-kit": "workspace:*",
		"@nseng-ai/ccc": "workspace:*",
		"@nseng-ai/ns": "workspace:*",
		"@nseng-ai/foundation": "workspace:*",
		"@nseng-ai/flow": "workspace:*",
		"@nseng-ai/handoffs": "workspace:*",
		"@nseng-ai/kernel": "workspace:*",
		"@nseng-ai/objectives": "workspace:*",
		"@nseng-ai/plans": "workspace:*",
		"@nseng-ai/review-reinvention-scanner": "workspace:*",
		"@nseng-ai/reviews": "workspace:*",
		"@nseng-ai/slots": "workspace:*",
		"@types/node": "catalog:",
		"@typescript/native-preview": "catalog:",
		"@withgraphite/graphite-cli": "catalog:",
		"jsonc-parser": "catalog:",
		"nscc": "workspace:*",
		"oxfmt": "catalog:",
		"oxlint": "catalog:",
		"syncpack": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	},
	"workspaces": [
		"packages/*",
		"packages/*/*",
		"../.ns/reviews/*/tools/*"
	],
	"patchedDependencies": {
		"@earendil-works/pi-ai@0.79.1": "patches/@earendil-works%2Fpi-ai@0.79.1.patch"
	},
	"dependencies": {
		"@nseng-ai/foundation": "workspace:*"
	}
}
