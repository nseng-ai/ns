{
	"name": "@nseng-ai/sdk",
	"version": "0.1.4",
	"description": "Emerging customer-facing ns CLI.",
	"type": "module",
	"exports": {
		".": "./src/sdk/index.ts",
		"./cli": "./src/cli/index.ts",
		"./command-io": "./src/runtime/command-io.ts",
		"./project-config/descriptor-package": "./src/project-config/descriptor-package.ts",
		"./context": "./src/cli/context.ts",
		"./extensions/acquisition": "./src/extensions/acquisition.ts",
		"./extensions/declared-descriptors": "./src/extensions/declared-descriptors.ts",
		"./progress-phase-state": "./src/sdk/progress-phase-state.ts",
		"./project-config": "./src/project-config/index.ts",
		"./project-config/points": "./src/project-config/points.ts",
		"./runtime/module-loader": "./src/runtime/module-loader.ts",
		"./testing": "./src/testing/index.ts"
	},
	"ns": {
		"tier": "sdk",
		"subpackages": [
			"cli",
			"extensions",
			"project-config",
			"runtime",
			"sdk",
			"testing"
		],
		"publicPluginApi": [
			"."
		],
		"internalWorkspaceExports": [
			"./cli",
			"./command-io",
			"./context",
			"./extensions/acquisition",
			"./extensions/declared-descriptors",
			"./project-config",
			"./project-config/descriptor-package",
			"./progress-phase-state",
			"./project-config/points",
			"./runtime/module-loader",
			"./testing"
		]
	},
	"scripts": {
		"check": "tsc -p tsconfig.json",
		"test": "cd ../.. && vitest run --config vitest.config.ts packages/sdk/test"
	},
	"dependencies": {
		"@nseng-ai/clinkr": "workspace:*",
		"@nseng-ai/foundation": "workspace:*",
		"jiti": "catalog:",
		"smol-toml": "catalog:",
		"zod": "catalog:"
	},
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"src",
		"README.md"
	]
}
