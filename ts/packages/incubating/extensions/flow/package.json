{
	"name": "@nseng-ai/flow",
	"version": "0.1.4",
	"license": "MIT",
	"files": [
		"src"
	],
	"type": "module",
	"exports": {
		"./api": "./src/api/index.ts",
		"./ns-extension": "./src/ns/extension.ts",
		"./land/api": "./src/land/api.ts",
		"./land/testing": "./src/land/testing.ts"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"check": "tsc -p tsconfig.json",
		"test": "cd ../../../.. && vitest run --config vitest.config.ts packages/incubating/extensions/flow/test",
		"pack:local": "pnpm --workspace-root exec ns-dev prepare-source-publish-package \"$PWD\" && npm pack ./dist/publish --pack-destination dist",
		"publish:dry-run": "pnpm --workspace-root exec ns-dev prepare-source-publish-package \"$PWD\" && npm publish --dry-run ./dist/publish"
	},
	"dependencies": {
		"@nseng-ai/clinkr": "workspace:*",
		"@nseng-ai/extension-kit": "workspace:*",
		"@nseng-ai/foundation": "workspace:*",
		"@nseng-ai/sdk": "workspace:*",
		"@nseng-ai/slots": "workspace:*",
		"zod": "catalog:"
	},
	"ns": {
		"tier": "extension",
		"subpackages": [
			"api",
			"autobranch",
			"autoslot",
			"changes",
			"checkpoint",
			"commit-display",
			"land",
			"phase-stream",
			"publication",
			"ns",
			"submit",
			"trunk-pull",
			"stack-squash"
		]
	}
}
