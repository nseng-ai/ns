{
	"name": "@nseng-ai/objectives",
	"version": "0.1.4",
	"type": "module",
	"exports": {
		".": "./src/core/index.ts",
		"./api": "./src/api/index.ts",
		"./ns-extension": "./src/ns/extension.ts",
		"./ns/commands/check": "./src/ns/commands/check.ts",
		"./ns/commands/exec-list-candidates": "./src/ns/commands/exec-list-candidates.ts",
		"./ns/commands/exec-load-orientations": "./src/ns/commands/exec-load-orientations.ts",
		"./ns/commands/exec-read-objective": "./src/ns/commands/exec-read-objective.ts",
		"./ns/commands/exec-publication-bind": "./src/ns/commands/exec-publication-bind.ts",
		"./ns/commands/exec-publication-publish": "./src/ns/commands/exec-publication-publish.ts",
		"./ns/commands/exec-runner-begin": "./src/ns/commands/exec-runner-begin.ts",
		"./ns/commands/exec-runner-finish": "./src/ns/commands/exec-runner-finish.ts",
		"./ns/commands/exec-runner-subagent-usage": "./src/ns/commands/exec-runner-subagent-usage.ts",
		"./ns/commands/exec-tracking-gate": "./src/ns/commands/exec-tracking-gate.ts",
		"./ns/commands/list": "./src/ns/commands/list.ts",
		"./ns/commands/show": "./src/ns/commands/show.ts"
	},
	"files": [
		"src",
		"README.md"
	],
	"scripts": {
		"check": "tsc -p tsconfig.json",
		"test": "cd ../../../.. && vitest run --config vitest.config.ts packages/incubating/extensions/objectives/test",
		"pack:local": "pnpm --workspace-root exec ns-dev prepare-source-publish-package \"$PWD\" && npm pack ./dist/publish --pack-destination dist",
		"publish:dry-run": "pnpm --workspace-root exec ns-dev prepare-source-publish-package \"$PWD\" && npm publish --dry-run ./dist/publish"
	},
	"dependencies": {
		"@nseng-ai/branch-context": "workspace:*",
		"@nseng-ai/clinkr": "workspace:*",
		"@nseng-ai/extension-kit": "workspace:*",
		"@nseng-ai/foundation": "workspace:*",
		"@nseng-ai/flow": "workspace:*",
		"@nseng-ai/sdk": "workspace:*",
		"yaml": "catalog:",
		"zod": "catalog:"
	},
	"ns": {
		"tier": "extension",
		"subpackages": [
			"api",
			"core",
			"runner",
			"publication",
			"ns"
		],
		"publishExtras": [
			{
				"kind": "skill",
				"name": "objective",
				"sourcePath": "skills/incubating/objectives/objective",
				"publishPath": "skills/objective"
			},
			{
				"kind": "skill",
				"name": "objective-autorun",
				"sourcePath": "skills/incubating/objectives/objective-autorun",
				"publishPath": "skills/objective-autorun"
			},
			{
				"kind": "skill",
				"name": "objective-close",
				"sourcePath": "skills/incubating/objectives/objective-close",
				"publishPath": "skills/objective-close"
			},
			{
				"kind": "skill",
				"name": "objective-create",
				"sourcePath": "skills/incubating/objectives/objective-create",
				"publishPath": "skills/objective-create"
			},
			{
				"kind": "skill",
				"name": "objective-critique",
				"sourcePath": "skills/incubating/objectives/objective-critique",
				"publishPath": "skills/objective-critique"
			},
			{
				"kind": "skill",
				"name": "objective-next",
				"sourcePath": "skills/incubating/objectives/objective-next",
				"publishPath": "skills/objective-next"
			},
			{
				"kind": "skill",
				"name": "objective-refresh",
				"sourcePath": "skills/incubating/objectives/objective-refresh",
				"publishPath": "skills/objective-refresh"
			},
			{
				"kind": "skill",
				"name": "objective-runner-step",
				"sourcePath": "skills/incubating/objectives/objective-runner-step",
				"publishPath": "skills/objective-runner-step"
			},
			{
				"kind": "skill",
				"name": "objective-update",
				"sourcePath": "skills/incubating/objectives/objective-update",
				"publishPath": "skills/objective-update"
			}
		]
	},
	"publishConfig": {
		"access": "public"
	}
}
