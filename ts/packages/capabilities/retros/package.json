{
	"name": "@nseng-ai/retros",
	"version": "0.1.3",
	"type": "module",
	"exports": {
		"./ns/commands/exec-collect-evidence": "./src/ns/commands/exec-collect-evidence.ts",
		"./ns/commands/exec-read-evidence-detail": "./src/ns/commands/exec-read-evidence-detail.ts",
		"./ns-extension": "./src/ns-extension.ts"
	},
	"files": [
		"src"
	],
	"scripts": {
		"check": "tsc --noEmit -p tsconfig.json",
		"test": "cd ../../.. && vitest run --config vitest.config.ts packages/capabilities/retros/test",
		"pack:local": "pnpm --workspace-root exec ns-dev prepare-source-publish-package \"$PWD\" && npm pack ./dist/publish --pack-destination dist",
		"publish:dry-run": "pnpm --workspace-root exec ns-dev prepare-source-publish-package \"$PWD\" && npm publish --dry-run ./dist/publish"
	},
	"dependencies": {
		"@nseng-ai/capability-kit": "workspace:*",
		"@nseng-ai/clinkr": "workspace:*",
		"@nseng-ai/foundation": "workspace:*",
		"@nseng-ai/sdk": "workspace:*",
		"zod": "catalog:"
	},
	"ns": {
		"tier": "capability"
	},
	"publishConfig": {
		"access": "public"
	}
}
