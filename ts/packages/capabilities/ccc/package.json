{
	"name": "@nseng-ai/ccc",
	"version": "0.1.1",
	"type": "module",
	"bin": {
		"ccc": "./src/ns/cli.ts"
	},
	"exports": {
		".": "./src/api/index.ts",
		"./api": "./src/api/handlers.ts",
		"./autoslot": "./src/ns/autoslot.ts",
		"./cli": "./src/ns/cli.ts",
		"./land": "./src/ns/land.ts",
		"./trunk-pull": "./src/ns/trunk-pull.ts",
		"./pi": "./src/pi/index.ts",
