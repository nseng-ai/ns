{
	"name": "@sdl/ccc",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"bin": {
		"ccc": "./src/sdl/cli.ts"
	},
	"exports": {
		".": "./src/api/index.ts",
		"./api": "./src/api/handlers.ts",
		"./autoslot": "./src/sdl/autoslot.ts",
		"./cli": "./src/sdl/cli.ts",
		"./land": "./src/sdl/land.ts",
		"./trunk-pull": "./src/sdl/trunk-pull.ts",
		"./pi": "./src/pi/index.ts",
		"./pi/extension": "./src/pi/extension.ts"
	},
	"scripts": {
		"check": "tsgo -p tsconfig.json",
		"test": "cd ../../.. && vitest run --config vitest.config.ts packages/capabilities/ccc/test"
	},
	"dependencies": {
		"@sdl/branch-context": "workspace:*",
		"@sdl/capability-kit": "workspace:*",
		"@sdl/clinkr": "workspace:*",
		"@sdl/core": "workspace:*",
		"@sdl/kernel": "workspace:*",
		"@sdl/objective": "workspace:*",
		"@sdl/plans": "workspace:*",
		"@sdl/slot": "workspace:*",
		"sdl-flow": "workspace:*",
		"zod": "catalog:"
	},
	"peerDependencies": {
		"@sdl/pi": "workspace:*"
	},
	"peerDependenciesMeta": {
		"@sdl/pi": {
			"optional": true
		}
	},
	"devDependencies": {
		"@sdl/pi": "workspace:*"
	},
	"sdl": {
		"tier": "capability",
		"subpackages": [
			"api",
			"cmux",
			"sdl",
			"pi"
		]
	}
}
