{
	"name": "@nseng-ai/vercel",
	"version": "0.1.2",
	"files": [
		"api",
		"scripts",
		"src",
		"vercel.json",
		"workflows"
	],
	"type": "module",
	"exports": {
		"./api": "./src/api/index.ts",
		"./ns-extension": "./src/ns/extension.ts",
		"./pi/extension": "./src/pi/extension.ts"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build:deployable": "node scripts/build-deployable.ts",
		"check": "tsc -p tsconfig.json",
		"deploy:production": "node scripts/deploy-production.ts",
		"dev:sandbox-hello-probe": "node --env-file=.env.local scripts/sandbox-hello-probe.ts",
		"test": "cd ../../.. && vitest run --config vitest.config.ts packages/capabilities/vercel/test",
		"verify:production-health": "node scripts/verify-production-health.ts",
		"pack:local": "node ../../../scripts/prepare-source-publish-package.mjs . && npm pack ./dist/publish --pack-destination dist",
		"publish:dry-run": "node ../../../scripts/prepare-source-publish-package.mjs . && npm publish --dry-run ./dist/publish"
	},
	"dependencies": {
		"@earendil-works/pi-coding-agent": "catalog:",
		"@nseng-ai/brmem": "workspace:*",
		"@nseng-ai/capability-kit": "workspace:*",
		"@nseng-ai/foundation": "workspace:*",
		"@nseng-ai/plans": "workspace:*",
		"@nseng-ai/sdk": "workspace:*",
		"@octokit/auth-app": "catalog:",
		"@vercel/sandbox": "catalog:",
		"@workflow/world-vercel": "catalog:",
		"esbuild": "catalog:",
		"jose": "catalog:",
		"smol-toml": "catalog:",
		"workflow": "catalog:",
		"zod": "catalog:"
	},
	"peerDependencies": {
		"@nseng-ai/pi": "workspace:*"
	},
	"peerDependenciesMeta": {
		"@nseng-ai/pi": {
			"optional": true
		}
	},
	"devDependencies": {
		"@nseng-ai/pi": "workspace:*"
	},
	"ns": {
		"tier": "capability",
		"group": "dispatch",
		"subpackages": [
			"api",
			"auth",
			"deployability",
			"dispatch",
			"dispatch-client",
			"http",
			"mint",
			"ns",
			"pi",
			"pi-runner",
			"sandbox",
			"trigger"
		],
		"settings": [
			{
				"path": [
					"dispatch"
				],
				"description": "Vercel-native cloud dispatch configuration."
			}
		]
	}
}
