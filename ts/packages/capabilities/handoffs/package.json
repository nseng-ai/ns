{
	"name": "@nseng-ai/handoffs",
	"version": "0.1.4",
	"type": "module",
	"exports": {
		".": "./src/core/index.ts",
		"./identity": "./src/core/identity.ts",
		"./api": "./src/api/index.ts",
		"./ns-extension": "./src/ns/extension.ts",
		"./ns/commands/list": "./src/ns/commands/list.ts",
		"./ns/commands/delete": "./src/ns/commands/delete.ts",
		"./ns/commands/gc": "./src/ns/commands/gc.ts",
		"./ns/commands/create": "./src/ns/commands/create.ts",
		"./ns/commands/pickup": "./src/ns/commands/pickup.ts",
		"./ns/commands/exec-match": "./src/ns/commands/exec-match.ts",
		"./pi": "./src/pi/index.ts",
		"./pi/extension": "./src/pi/extension.ts"
	},
	"files": [
		"src"
	],
	"scripts": {
		"check": "tsc -p tsconfig.json",
		"test": "cd ../../.. && vitest run --config vitest.config.ts packages/capabilities/handoffs/test",
		"pack:local": "pnpm --workspace-root exec ns-dev prepare-source-publish-package \"$PWD\" && npm pack ./dist/publish --pack-destination dist",
		"publish:dry-run": "pnpm --workspace-root exec ns-dev prepare-source-publish-package \"$PWD\" && npm publish --dry-run ./dist/publish"
	},
	"dependencies": {
		"@nseng-ai/brmem": "workspace:*",
		"@nseng-ai/capability-kit": "workspace:*",
		"@nseng-ai/clinkr": "workspace:*",
		"@nseng-ai/foundation": "workspace:*",
		"@nseng-ai/sdk": "workspace:*",
		"zod": "catalog:"
	},
	"ns": {
		"tier": "capability",
		"subpackages": [
			"api",
			"core",
			"ns",
			"pi"
		]
	},
	"peerDependencies": {
		"@nseng-ai/pi": "workspace:*"
	},
	"peerDependenciesMeta": {
		"@nseng-ai/pi": {
			"optional": true
		}
	},
	"devDependencies": {
		"@nseng-ai/pi": "workspace:*"
	},
	"publishConfig": {
		"access": "public"
	}
}
