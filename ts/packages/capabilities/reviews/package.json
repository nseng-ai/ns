{
	"name": "@nseng-ai/reviews",
	"version": "0.1.1",
	"type": "module",
	"exports": {
		".": "./src/core/index.ts",
		"./api": "./src/core/api.ts",
		"./commands/review-list": "./src/commands/review-list.ts",
		"./commands/review-ls": "./src/commands/review-ls.ts",
		"./commands/review-log": "./src/commands/review-log.ts",
		"./commands/review-run": "./src/commands/review-run.ts",
		"./commands/exec-record-findings": "./src/commands/exec-record-findings.ts",
		"./commands/exec-publish-findings": "./src/commands/exec-publish-findings.ts",
		"./commands/roast-list": "./src/commands/roast-list.ts",
		"./skill-reviews": "./src/core/skill-reviews.ts",
		"./repo-local-ns-extension": "./src/core/repo-local-ns-extension.ts"
	},
	"files": [
		"src"
	],
	"scripts": {
		"check": "tsgo -p tsconfig.json",
		"test": "cd ../../.. && vitest run --config vitest.config.ts packages/capabilities/reviews/test",
		"pack:local": "node ../../../scripts/prepare-source-publish-package.mjs . && npm pack ./dist/publish --pack-destination dist",
		"publish:dry-run": "node ../../../scripts/prepare-source-publish-package.mjs . && npm publish --dry-run ./dist/publish"
	},
	"dependencies": {
		"@nseng-ai/capability-kit": "workspace:*",
		"@nseng-ai/clinkr": "workspace:*",
		"@nseng-ai/foundation": "workspace:*",
		"@nseng-ai/kernel": "workspace:*",
		"@pierre/diffs": "catalog:",
		"smol-toml": "catalog:",
		"yaml": "catalog:",
		"zod": "catalog:"
	},
	"ns": {
		"tier": "standalone-tool"
	},
	"publishConfig": {
		"access": "public"
	}
}
