{
	"name": "@nseng-ai/ns",
	"version": "0.1.4",
	"description": "Checkout-free ns CLI package.",
	"files": [
		"api",
		"bin",
		"cli",
		"sdk",
		"README.md"
	],
	"type": "module",
	"exports": {
		"./api": "./src/api/index.ts",
		"./cli": "./src/cli/index.ts",
		"./sdk": "./src/sdk/sdk.ts",
		"./sdk/cli": "./src/sdk/cli.ts",
		"./sdk/command-io": "./src/sdk/command-io.ts",
		"./sdk/context": "./src/sdk/context.ts"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build:bundle": "node scripts/build-bundle.mjs",
		"check": "tsc -p tsconfig.json",
		"pack:local": "pnpm run build:bundle && node scripts/prepare-local-package.mjs && npm pack --no-workspaces ./dist/publish --pack-destination dist",
		"publish:dry-run": "pnpm run build:bundle && node scripts/prepare-local-package.mjs && npm publish --no-workspaces --dry-run ./dist/publish",
		"smoke:checkout-free": "node scripts/smoke-checkout-free.mjs",
		"test": "cd ../../.. && vitest run --config vitest.config.ts packages/public/ns/test",
		"prepublishOnly": "node -e \"throw new Error('Use pnpm --dir ts run release:publish / release:publish-dry-run; @nseng-ai/ns is published from dist/publish only.')\""
	},
	"dependencies": {
		"@earendil-works/pi-agent-core": "catalog:",
		"@earendil-works/pi-ai": "catalog:",
		"@earendil-works/pi-coding-agent": "catalog:",
		"@nseng-ai/clinkr": "workspace:*",
		"@nseng-ai/extension-kit": "workspace:*",
		"@nseng-ai/foundation": "workspace:*",
		"@nseng-ai/sdk": "workspace:*",
		"jiti": "catalog:",
		"smol-toml": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@internal/ns-dev": "workspace:*",
		"esbuild": "catalog:"
	},
	"engines": {
		"node": ">=24.12.0"
	},
	"ns": {
		"tier": "host",
		"settings": [
			{
				"path": [
					"harnesses"
				],
				"description": "Harness IDs ns init should activate when --harness is not supplied."
			}
		],
		"subpackages": [
			"api",
			"cli",
			"harness-artifacts",
			"init",
			"sdk"
		],
		"remainder": true
	}
}
