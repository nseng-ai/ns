{
	"name": "@nseng-ai/clinkr",
	"version": "0.1.4",
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./app": "./src/app/index.ts",
		"./app/testing": "./src/app/testing.ts",
		"./completion": "./src/completion.ts",
		"./raw": "./src/raw/index.ts",
		"./stream": "./src/stream/index.ts",
		"./testing": "./src/testing/index.ts"
	},
	"files": [
		"src"
	],
	"scripts": {
		"check": "tsc -p tsconfig.json",
		"test": "cd ../../../.. && vitest run --config vitest.config.ts packages/public/infra/clinkr/test",
		"pack:local": "pnpm --workspace-root exec ns-dev prepare-source-publish-package \"$PWD\" && npm pack ./dist/publish --pack-destination dist",
		"publish:dry-run": "pnpm --workspace-root exec ns-dev prepare-source-publish-package \"$PWD\" && npm publish --dry-run ./dist/publish"
	},
	"dependencies": {
		"commander": "catalog:",
		"log-update": "catalog:"
	},
	"devDependencies": {
		"@xterm/headless": "catalog:",
		"zod": "catalog:"
	},
	"peerDependencies": {
		"zod": "catalog:"
	},
	"engines": {
		"node": ">=24.12.0"
	},
	"ns": {
		"tier": "neutral-infra"
	},
	"publishConfig": {
		"access": "public"
	}
}
