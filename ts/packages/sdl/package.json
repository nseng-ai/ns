{
  "name": "@asdl/sdl",
  "private": true,
  "description": "Emerging customer-facing Source Development Lifecycle CLI.",
  "type": "module",
  "exports": {
    "./checkpoint": "./src/checkpoint.ts",
    "./checkpoint-flow": "./src/checkpoint-flow.ts",
    "./checkpoint-message": "./src/checkpoint-message.ts",
    "./cli": "./src/cli.ts",
    "./context": "./src/context.ts",
    "./pending-worktree": "./src/pending-worktree.ts",
    "./pi-text-generation": "./src/pi-text-generation.ts",
    "./sdk": "./src/sdk.ts",
    "./text-generation": "./src/text-generation.ts",
    "./text-repair": "./src/text-repair.ts"
  },
  "asdl": {
    "publicPluginApi": ["./sdk"],
    "internalMigrationExports": [
      "./checkpoint",
      "./checkpoint-flow",
      "./checkpoint-message",
      "./cli",
      "./context",
      "./pending-worktree",
      "./pi-text-generation",
      "./text-generation",
      "./text-repair"
    ]
  },
  "bin": {
    "sdl": "./src/cli.ts"
  },
  "scripts": {
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "cd ../.. && vitest run --config vitest.config.ts packages/sdl/test"
  },
  "dependencies": {
    "@asdl/clinkr": "workspace:*",
    "@asdl/core": "workspace:*",
    "@asdl/plans": "workspace:*",
    "@earendil-works/pi-ai": "0.79.1",
    "@earendil-works/pi-coding-agent": "0.79.1",
    "jiti": "2.7.0",
    "zod": "^4.4.3"
  }
}
