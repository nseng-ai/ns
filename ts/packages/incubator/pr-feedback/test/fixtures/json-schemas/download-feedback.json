{
  "inputJsonSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "prNumber": {
        "type": "integer",
        "minimum": -9007199254740991,
        "maximum": 9007199254740991
      },
      "includeResolved": {
        "default": false,
        "type": "boolean"
      },
      "includeAutomation": {
        "default": false,
        "type": "boolean"
      },
      "includeEmptyReviews": {
        "default": false,
        "type": "boolean"
      }
    }
  },
  "outputJsonSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "found": {
        "type": "boolean"
      },
      "target": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "const": "github-pr"
          },
          "pr_number": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "branch": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "head_ref_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "base_ref_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "kind",
          "pr_number",
          "branch",
          "title",
          "url",
          "head_ref_name",
          "base_ref_name"
        ],
        "additionalProperties": false
      },
      "counts": {
        "type": "object",
        "properties": {
          "includedReviewThreads": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "includedReviews": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "includedDiscussionComments": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "excludedResolvedThreads": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "excludedEmptyReviews": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "excludedAutomationComments": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "includedReviewThreads",
          "includedReviews",
          "includedDiscussionComments",
          "excludedResolvedThreads",
          "excludedEmptyReviews",
          "excludedAutomationComments"
        ],
        "additionalProperties": false
      },
      "markdown": {
        "type": "string"
      }
    },
    "required": [
      "found",
      "target",
      "counts",
      "markdown"
    ],
    "additionalProperties": false
  }
}
