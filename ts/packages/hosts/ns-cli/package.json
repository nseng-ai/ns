{
	"name": "@nseng-ai/ns",
	"version": "0.1.0",
	"description": "Checkout-free ns CLI package.",
	"type": "module",
	"bin": {
		"ns": "bin/ns.js"
	},
	"exports": {
		"./kernel/cli": "./src/kernel/cli.ts",
		"./kernel/command-io": "./src/kernel/command-io.ts",
		"./kernel/context": "./src/kernel/context.ts",
		"./kernel/pi-text-generation": "./src/kernel/pi-text-generation.ts",
		"./kernel/sdk": "./src/kernel/sdk.ts"
	},
	"files": [
		"bin",
		"kernel",
		"README.md"
	],
	"engines": {
		"node": ">=24.12.0"
	},
	"scripts": {
		"build:bundle": "node scripts/build-bundle.mjs",
		"check": "tsgo -p tsconfig.json",
		"pack:local": "pnpm run build:bundle && node scripts/prepare-local-package.mjs && npm pack ./dist/publish --pack-destination dist",
		"publish:dry-run": "pnpm run build:bundle && node scripts/prepare-local-package.mjs && npm publish --dry-run ./dist/publish",
		"smoke:checkout-free": "node scripts/smoke-checkout-free.mjs",
		"test": "cd ../../.. && vitest run --config vitest.config.ts packages/hosts/ns-cli/test"
	},
	"dependencies": {
		"@earendil-works/pi-ai": "catalog:",
		"@earendil-works/pi-coding-agent": "catalog:",
		"@nseng-ai/branch-context": "workspace:*",
		"@nseng-ai/kernel": "workspace:*",
		"@nseng-ai/ns-init": "workspace:*",
		"@nseng-ai/objectives": "workspace:*",
		"jiti": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"esbuild": "catalog:"
	},
	"ns": {
		"tier": "host",
		"subpackages": [
			"kernel"
		],
		"remainder": true
	}
}
