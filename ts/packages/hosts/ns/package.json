{
	"name": "@nseng-ai/ns",
	"version": "0.1.3",
	"description": "Checkout-free ns CLI package.",
	"bin": {
		"ns": "bin/ns.js"
	},
	"files": [
		"bin",
		"cli",
		"sdk",
		"README.md"
	],
	"type": "module",
	"exports": {
		"./cli": "./src/cli/index.ts",
		"./sdk": "./src/sdk/sdk.ts",
		"./sdk/cli": "./src/sdk/cli.ts",
		"./sdk/command-io": "./src/sdk/command-io.ts",
		"./sdk/context": "./src/sdk/context.ts"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build:bundle": "node scripts/build-bundle.mjs",
		"check": "tsc -p tsconfig.json",
		"pack:local": "pnpm run build:bundle && node scripts/prepare-local-package.mjs && npm pack ./dist/publish --pack-destination dist",
		"publish:dry-run": "pnpm run build:bundle && node scripts/prepare-local-package.mjs && npm publish --dry-run ./dist/publish",
		"smoke:checkout-free": "node scripts/smoke-checkout-free.mjs",
		"test": "cd ../../.. && vitest run --config vitest.config.ts packages/hosts/ns/test",
		"prepublishOnly": "node -e \"throw new Error('Use pnpm --dir ts run release:publish / release:publish-dry-run; @nseng-ai/ns is published from dist/publish only.')\""
	},
	"dependencies": {
		"@earendil-works/pi-agent-core": "catalog:",
		"@earendil-works/pi-ai": "catalog:",
		"@earendil-works/pi-coding-agent": "catalog:",
		"@nseng-ai/branch-context": "workspace:*",
		"@nseng-ai/harness-artifacts": "workspace:*",
		"@nseng-ai/sdk": "workspace:*",
		"@nseng-ai/ns-init": "workspace:*",
		"jiti": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"esbuild": "catalog:"
	},
	"engines": {
		"node": ">=24.12.0"
	},
	"ns": {
		"tier": "host",
		"subpackages": [
			"cli",
			"sdk"
		],
		"remainder": true
	}
}
