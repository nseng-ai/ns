{
  "input_json_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "branches_json": {
        "type": "string"
      },
      "harness_session_id": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "stdout_mode": {
        "type": "string",
        "enum": [
          "full",
          "compact"
        ]
      }
    },
    "additionalProperties": false
  },
  "output_json_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "anyOf": [
      {
        "type": "object",
        "properties": {
          "branch_prs": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "branch": {
                  "type": "string"
                },
                "pr_number": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "title": {
                  "type": "string"
                },
                "url": {
                  "type": "string"
                },
                "head_ref_name": {
                  "type": "string"
                },
                "base_ref_name": {
                  "type": "string"
                }
              },
              "required": [
                "branch",
                "pr_number",
                "title",
                "url",
                "head_ref_name",
                "base_ref_name"
              ],
              "additionalProperties": false
            }
          },
          "missing_branches": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "summary": {
            "type": "object",
            "properties": {
              "requested": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "matched": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "missing": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "requested",
              "matched",
              "missing"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "branch_prs",
          "missing_branches",
          "summary"
        ],
        "additionalProperties": false
      },
      {
        "type": "object",
        "properties": {
          "operation": {
            "type": "string"
          },
          "counts": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "summary": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "errors": {
            "type": "array",
            "items": {}
          },
          "warnings": {
            "type": "array",
            "items": {}
          },
          "resolved_inputs": {},
          "artifacts": {
            "type": "object",
            "properties": {
              "full_output": {
                "type": "object",
                "properties": {
                  "payload_path": {
                    "type": "string"
                  },
                  "session_id": {
                    "type": "string"
                  },
                  "descriptor": {
                    "type": "string"
                  },
                  "role": {
                    "type": "string",
                    "enum": [
                      "raw",
                      "summary",
                      "log"
                    ]
                  },
                  "created_at_utc": {
                    "type": "string"
                  },
                  "sequence": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  "payload_bytes": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  "content_type": {
                    "type": "string"
                  },
                  "extension": {
                    "type": "string",
                    "enum": [
                      "json",
                      "txt"
                    ]
                  }
                },
                "required": [
                  "payload_path",
                  "session_id",
                  "descriptor",
                  "role",
                  "created_at_utc",
                  "sequence",
                  "payload_bytes",
                  "content_type",
                  "extension"
                ],
                "additionalProperties": false
              },
              "produced": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string"
                    },
                    "reference": {
                      "type": "object",
                      "properties": {
                        "payload_path": {
                          "type": "string"
                        },
                        "session_id": {
                          "type": "string"
                        },
                        "descriptor": {
                          "type": "string"
                        },
                        "role": {
                          "type": "string",
                          "enum": [
                            "raw",
                            "summary",
                            "log"
                          ]
                        },
                        "created_at_utc": {
                          "type": "string"
                        },
                        "sequence": {
                          "type": "integer",
                          "minimum": -9007199254740991,
                          "maximum": 9007199254740991
                        },
                        "payload_bytes": {
                          "type": "integer",
                          "minimum": -9007199254740991,
                          "maximum": 9007199254740991
                        },
                        "content_type": {
                          "type": "string"
                        },
                        "extension": {
                          "type": "string",
                          "enum": [
                            "json",
                            "txt"
                          ]
                        }
                      },
                      "required": [
                        "payload_path",
                        "session_id",
                        "descriptor",
                        "role",
                        "created_at_utc",
                        "sequence",
                        "payload_bytes",
                        "content_type",
                        "extension"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "kind",
                    "reference"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": {}
          },
          "details": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          }
        },
        "required": [
          "operation"
        ],
        "additionalProperties": {}
      }
    ]
  }
}
