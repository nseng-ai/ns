{
  "input_json_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "payload_json": {
        "default": null,
        "description": "Inline wrapper payload JSON.",
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "payload_file": {
        "default": null,
        "description": "Path to a wrapper payload JSON file.",
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "manifest_json": {
        "default": null,
        "description": "Inline split manifest JSON.",
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "manifest_file": {
        "default": null,
        "description": "Path to a split manifest JSON file.",
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "classification_json": {
        "default": null,
        "description": "Inline split or session classification JSON.",
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "classification_file": {
        "default": null,
        "description": "Path to a split or session classification JSON file.",
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "pr_number": {
        "anyOf": [
          {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          {
            "type": "null"
          }
        ],
        "description": "PR number for implicit manifest session resolution."
      },
      "harness_session_id": {
        "default": null,
        "description": "Harness session id for implicit session resolution or explicit persistence.",
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "persist_session": {
        "default": false,
        "description": "Persist the validated classification artifact into the configured payload session for legacy explicit input modes.",
        "type": "boolean"
      }
    },
    "required": [
      "payload_json",
      "payload_file",
      "manifest_json",
      "manifest_file",
      "classification_json",
      "classification_file",
      "pr_number",
      "harness_session_id",
      "persist_session"
    ],
    "additionalProperties": false
  },
  "output_json_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "valid": {
        "type": "boolean"
      },
      "manifest_kind": {
        "type": "string",
        "enum": [
          "get_feedback",
          "prepare_run"
        ]
      },
      "pr_number": {
        "anyOf": [
          {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          {
            "type": "null"
          }
        ]
      },
      "payload_path": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "counts": {
        "type": "object",
        "properties": {
          "reviews_expected": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "reviews_classified": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "review_threads_expected": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "review_threads_classified": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "thread_comments_expected": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "thread_comments_covered": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "discussion_comments_expected": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "discussion_comments_classified": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "reviews_expected",
          "reviews_classified",
          "review_threads_expected",
          "review_threads_classified",
          "thread_comments_expected",
          "thread_comments_covered",
          "discussion_comments_expected",
          "discussion_comments_classified"
        ],
        "additionalProperties": false
      },
      "errors": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "enum": [
                "review",
                "review_thread",
                "thread_comment",
                "discussion_comment",
                "packet"
              ]
            },
            "identifier": {
              "anyOf": [
                {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "number"
                    }
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "path": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "code",
            "message",
            "kind",
            "identifier",
            "path"
          ],
          "additionalProperties": false
        }
      },
      "classification_reference": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "payload_path": {
                "type": "string"
              },
              "session_id": {
                "type": "string"
              },
              "descriptor": {
                "type": "string"
              },
              "role": {
                "type": "string",
                "enum": [
                  "raw",
                  "summary",
                  "log"
                ]
              },
              "created_at_utc": {
                "type": "string"
              },
              "sequence": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "payload_bytes": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "content_type": {
                "type": "string"
              },
              "extension": {
                "type": "string",
                "enum": [
                  "json",
                  "txt"
                ]
              }
            },
            "required": [
              "payload_path",
              "session_id",
              "descriptor",
              "role",
              "created_at_utc",
              "sequence",
              "payload_bytes",
              "content_type",
              "extension"
            ],
            "additionalProperties": false
          },
          {
            "type": "null"
          }
        ]
      },
      "resolved_inputs": {
        "type": "object",
        "properties": {
          "manifest": {
            "type": "object",
            "properties": {
              "payload_path": {
                "type": "string"
              },
              "session_id": {
                "type": "string"
              },
              "descriptor": {
                "type": "string"
              },
              "role": {
                "type": "string",
                "enum": [
                  "raw",
                  "summary",
                  "log"
                ]
              },
              "created_at_utc": {
                "type": "string"
              },
              "sequence": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "payload_bytes": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "content_type": {
                "type": "string"
              },
              "extension": {
                "type": "string",
                "enum": [
                  "json",
                  "txt"
                ]
              }
            },
            "required": [
              "payload_path",
              "session_id",
              "descriptor",
              "role",
              "created_at_utc",
              "sequence",
              "payload_bytes",
              "content_type",
              "extension"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "manifest"
        ],
        "additionalProperties": false
      }
    },
    "required": [
      "valid",
      "manifest_kind",
      "pr_number",
      "payload_path",
      "counts",
      "errors"
    ],
    "additionalProperties": false
  }
}
