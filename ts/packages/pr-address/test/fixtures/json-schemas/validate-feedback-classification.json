{
  "input_json_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "pr_number": {
        "type": "integer",
        "minimum": -9007199254740991,
        "maximum": 9007199254740991,
        "description": "PR number for payload-session manifest resolution and classification persistence."
      },
      "classification_json": {
        "default": null,
        "description": "Inline PR feedback classification packet JSON.",
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "classification_file": {
        "default": null,
        "description": "Path to a PR feedback classification packet JSON file.",
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "harness_session_id": {
        "default": null,
        "description": "Payload session id override for manifest resolution and classification persistence.",
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "stdout_mode": {
        "description": "Stdout contract: compact stores full data in payload artifacts; full prints the full result inline.",
        "type": "string",
        "enum": [
          "full",
          "compact"
        ]
      }
    },
    "required": [
      "pr_number",
      "classification_json",
      "classification_file",
      "harness_session_id"
    ],
    "additionalProperties": false
  },
  "output_json_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "anyOf": [
      {
        "type": "object",
        "properties": {
          "valid": {
            "type": "boolean"
          },
          "manifest_kind": {
            "type": "string",
            "enum": [
              "get_feedback",
              "prepare_run"
            ]
          },
          "pr_number": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "payload_path": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "counts": {
            "type": "object",
            "properties": {
              "reviews_expected": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "reviews_classified": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "review_threads_expected": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "review_threads_classified": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "thread_comments_expected": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "thread_comments_covered": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "discussion_comments_expected": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "discussion_comments_classified": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "reviews_expected",
              "reviews_classified",
              "review_threads_expected",
              "review_threads_classified",
              "thread_comments_expected",
              "thread_comments_covered",
              "discussion_comments_expected",
              "discussion_comments_classified"
            ],
            "additionalProperties": false
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "review",
                    "review_thread",
                    "thread_comment",
                    "discussion_comment",
                    "packet"
                  ]
                },
                "identifier": {
                  "anyOf": [
                    {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "number"
                        }
                      ]
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "path": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "code",
                "message",
                "kind",
                "identifier",
                "path"
              ],
              "additionalProperties": false
            }
          },
          "classification_reference": {
            "type": "object",
            "properties": {
              "payload_path": {
                "type": "string"
              },
              "session_id": {
                "type": "string"
              },
              "descriptor": {
                "type": "string"
              },
              "role": {
                "type": "string",
                "enum": [
                  "raw",
                  "summary",
                  "log"
                ]
              },
              "created_at_utc": {
                "type": "string"
              },
              "sequence": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "payload_bytes": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "content_type": {
                "type": "string"
              },
              "extension": {
                "type": "string",
                "enum": [
                  "json",
                  "txt"
                ]
              }
            },
            "required": [
              "payload_path",
              "session_id",
              "descriptor",
              "role",
              "created_at_utc",
              "sequence",
              "payload_bytes",
              "content_type",
              "extension"
            ],
            "additionalProperties": false
          },
          "resolved_inputs": {
            "type": "object",
            "properties": {
              "manifest": {
                "type": "object",
                "properties": {
                  "payload_path": {
                    "type": "string"
                  },
                  "session_id": {
                    "type": "string"
                  },
                  "descriptor": {
                    "type": "string"
                  },
                  "role": {
                    "type": "string",
                    "enum": [
                      "raw",
                      "summary",
                      "log"
                    ]
                  },
                  "created_at_utc": {
                    "type": "string"
                  },
                  "sequence": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  "payload_bytes": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  "content_type": {
                    "type": "string"
                  },
                  "extension": {
                    "type": "string",
                    "enum": [
                      "json",
                      "txt"
                    ]
                  }
                },
                "required": [
                  "payload_path",
                  "session_id",
                  "descriptor",
                  "role",
                  "created_at_utc",
                  "sequence",
                  "payload_bytes",
                  "content_type",
                  "extension"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "manifest"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "valid",
          "manifest_kind",
          "pr_number",
          "payload_path",
          "counts",
          "errors",
          "resolved_inputs"
        ],
        "additionalProperties": false
      },
      {
        "type": "object",
        "properties": {
          "operation": {
            "type": "string"
          },
          "counts": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "summary": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "errors": {
            "type": "array",
            "items": {}
          },
          "warnings": {
            "type": "array",
            "items": {}
          },
          "resolved_inputs": {},
          "artifacts": {
            "type": "object",
            "properties": {
              "full_output": {
                "type": "object",
                "properties": {
                  "payload_path": {
                    "type": "string"
                  },
                  "session_id": {
                    "type": "string"
                  },
                  "descriptor": {
                    "type": "string"
                  },
                  "role": {
                    "type": "string",
                    "enum": [
                      "raw",
                      "summary",
                      "log"
                    ]
                  },
                  "created_at_utc": {
                    "type": "string"
                  },
                  "sequence": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  "payload_bytes": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  "content_type": {
                    "type": "string"
                  },
                  "extension": {
                    "type": "string",
                    "enum": [
                      "json",
                      "txt"
                    ]
                  }
                },
                "required": [
                  "payload_path",
                  "session_id",
                  "descriptor",
                  "role",
                  "created_at_utc",
                  "sequence",
                  "payload_bytes",
                  "content_type",
                  "extension"
                ],
                "additionalProperties": false
              },
              "produced": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string"
                    },
                    "reference": {
                      "type": "object",
                      "properties": {
                        "payload_path": {
                          "type": "string"
                        },
                        "session_id": {
                          "type": "string"
                        },
                        "descriptor": {
                          "type": "string"
                        },
                        "role": {
                          "type": "string",
                          "enum": [
                            "raw",
                            "summary",
                            "log"
                          ]
                        },
                        "created_at_utc": {
                          "type": "string"
                        },
                        "sequence": {
                          "type": "integer",
                          "minimum": -9007199254740991,
                          "maximum": 9007199254740991
                        },
                        "payload_bytes": {
                          "type": "integer",
                          "minimum": -9007199254740991,
                          "maximum": 9007199254740991
                        },
                        "content_type": {
                          "type": "string"
                        },
                        "extension": {
                          "type": "string",
                          "enum": [
                            "json",
                            "txt"
                          ]
                        }
                      },
                      "required": [
                        "payload_path",
                        "session_id",
                        "descriptor",
                        "role",
                        "created_at_utc",
                        "sequence",
                        "payload_bytes",
                        "content_type",
                        "extension"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "kind",
                    "reference"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": {}
          },
          "details": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          }
        },
        "required": [
          "operation"
        ],
        "additionalProperties": {}
      }
    ]
  }
}
