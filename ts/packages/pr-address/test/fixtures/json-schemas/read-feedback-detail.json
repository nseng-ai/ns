{
  "input_json_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "payload_path": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "pr_number": {
        "anyOf": [
          {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          {
            "type": "null"
          }
        ]
      },
      "json_pointer": {
        "type": "string"
      },
      "harness_session_id": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "required": [
      "json_pointer"
    ],
    "additionalProperties": false
  },
  "output_json_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "payload_path": {
        "type": "string"
      },
      "json_pointer": {
        "type": "string"
      },
      "detail_kind": {
        "type": "string",
        "enum": [
          "review",
          "review_body",
          "review_thread",
          "thread_comment",
          "thread_comment_body",
          "discussion_comment",
          "discussion_comment_body"
        ]
      },
      "value": {},
      "resolved_inputs": {
        "type": "object",
        "properties": {
          "feedback": {
            "type": "object",
            "properties": {
              "payload_path": {
                "type": "string"
              },
              "session_id": {
                "type": "string"
              },
              "descriptor": {
                "type": "string"
              },
              "role": {
                "type": "string",
                "enum": [
                  "raw",
                  "summary",
                  "log"
                ]
              },
              "created_at_utc": {
                "type": "string"
              },
              "sequence": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "payload_bytes": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "content_type": {
                "type": "string"
              },
              "extension": {
                "type": "string",
                "enum": [
                  "json",
                  "txt"
                ]
              }
            },
            "required": [
              "payload_path",
              "session_id",
              "descriptor",
              "role",
              "created_at_utc",
              "sequence",
              "payload_bytes",
              "content_type",
              "extension"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "feedback"
        ],
        "additionalProperties": false
      }
    },
    "required": [
      "payload_path",
      "json_pointer",
      "detail_kind",
      "value"
    ],
    "additionalProperties": false
  }
}
