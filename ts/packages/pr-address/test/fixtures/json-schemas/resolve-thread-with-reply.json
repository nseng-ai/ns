{
  "input_json_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "stdout_mode": {
        "type": "string",
        "enum": [
          "full",
          "compact"
        ]
      },
      "thread_id": {
        "type": "string"
      },
      "mode": {
        "type": "string",
        "enum": [
          "fixed",
          "pre_existing",
          "explained",
          "planned"
        ]
      },
      "message": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "commit_sha": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "provenance_json": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "harness_session_id": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "required": [
      "thread_id",
      "mode",
      "message",
      "commit_sha"
    ],
    "additionalProperties": false
  },
  "output_json_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "anyOf": [
      {
        "type": "object",
        "properties": {
          "thread_id": {
            "type": "string"
          },
          "body": {
            "type": "string"
          },
          "comment": {
            "type": "object",
            "properties": {
              "id": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "body": {
                "type": "string"
              },
              "author": {
                "type": "string"
              },
              "path": {
                "type": "string"
              },
              "line": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "created_at": {
                "type": "string"
              },
              "start_line": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "id",
              "body",
              "author",
              "path",
              "line",
              "created_at"
            ],
            "additionalProperties": {}
          },
          "is_resolved": {
            "type": "boolean"
          },
          "provenance": {
            "anyOf": [
              {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "const": "local_branch"
                      },
                      "branch": {
                        "type": "string"
                      },
                      "branch_head_oid": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "kind",
                      "branch",
                      "branch_head_oid"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "const": "pr"
                      },
                      "pr_number": {
                        "type": "integer",
                        "minimum": -9007199254740991,
                        "maximum": 9007199254740991
                      },
                      "pr_url": {
                        "type": "string"
                      },
                      "pr_state": {
                        "type": "string"
                      },
                      "pr_head_ref_name": {
                        "type": "string"
                      },
                      "pr_head_ref_oid": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      }
                    },
                    "required": [
                      "kind",
                      "pr_number",
                      "pr_url",
                      "pr_state",
                      "pr_head_ref_name"
                    ],
                    "additionalProperties": false
                  }
                ]
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "thread_id",
          "body",
          "comment",
          "is_resolved"
        ],
        "additionalProperties": false
      },
      {
        "type": "object",
        "properties": {
          "operation": {
            "type": "string"
          },
          "counts": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "summary": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "errors": {
            "type": "array",
            "items": {}
          },
          "warnings": {
            "type": "array",
            "items": {}
          },
          "resolved_inputs": {},
          "artifacts": {
            "type": "object",
            "properties": {
              "full_output": {
                "type": "object",
                "properties": {
                  "payload_path": {
                    "type": "string"
                  },
                  "session_id": {
                    "type": "string"
                  },
                  "descriptor": {
                    "type": "string"
                  },
                  "role": {
                    "type": "string",
                    "enum": [
                      "raw",
                      "summary",
                      "log"
                    ]
                  },
                  "created_at_utc": {
                    "type": "string"
                  },
                  "sequence": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  "payload_bytes": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  "content_type": {
                    "type": "string"
                  },
                  "extension": {
                    "type": "string",
                    "enum": [
                      "json",
                      "txt"
                    ]
                  }
                },
                "required": [
                  "payload_path",
                  "session_id",
                  "descriptor",
                  "role",
                  "created_at_utc",
                  "sequence",
                  "payload_bytes",
                  "content_type",
                  "extension"
                ],
                "additionalProperties": false
              },
              "produced": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string"
                    },
                    "reference": {
                      "type": "object",
                      "properties": {
                        "payload_path": {
                          "type": "string"
                        },
                        "session_id": {
                          "type": "string"
                        },
                        "descriptor": {
                          "type": "string"
                        },
                        "role": {
                          "type": "string",
                          "enum": [
                            "raw",
                            "summary",
                            "log"
                          ]
                        },
                        "created_at_utc": {
                          "type": "string"
                        },
                        "sequence": {
                          "type": "integer",
                          "minimum": -9007199254740991,
                          "maximum": 9007199254740991
                        },
                        "payload_bytes": {
                          "type": "integer",
                          "minimum": -9007199254740991,
                          "maximum": 9007199254740991
                        },
                        "content_type": {
                          "type": "string"
                        },
                        "extension": {
                          "type": "string",
                          "enum": [
                            "json",
                            "txt"
                          ]
                        }
                      },
                      "required": [
                        "payload_path",
                        "session_id",
                        "descriptor",
                        "role",
                        "created_at_utc",
                        "sequence",
                        "payload_bytes",
                        "content_type",
                        "extension"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "kind",
                    "reference"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": {}
          },
          "details": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          }
        },
        "required": [
          "operation"
        ],
        "additionalProperties": {}
      }
    ]
  }
}
