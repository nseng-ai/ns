          },
          "state": {
            "enum": [
              "PENDING",
              "COMMENTED",
              "APPROVED",
              "CHANGES_REQUESTED",
              "DISMISSED"
            ],
            "title": "State",
            "type": "string"
          },
          "submitted_at": {
            "title": "Submitted At",
            "type": "string"
          },
          "body_locator": {
            "$ref": "#/$defs/BodyLocator"
          }
        },
        "required": [
          "id",
          "author",
          "state",
          "submitted_at",
          "body_locator"
        ],
        "title": "ReviewManifestItem",
        "type": "object"
      },
      "ThreadCommentManifestItem": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "author": {
            "title": "Author",
            "type": "string"
          },
          "path": {
            "title": "Path",
            "type": "string"
          },
          "line": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Line"
          },
          "start_line": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Start Line"
          },
          "created_at": {
            "title": "Created At",
            "type": "string"
          },
          "body_locator": {
            "$ref": "#/$defs/BodyLocator"
          }
        },
        "required": [
          "id",
          "author",
          "path",
          "line",
          "start_line",
          "created_at",
          "body_locator"
        ],
        "title": "ThreadCommentManifestItem",
        "type": "object"
      },
      "ThreadManifestItem": {
        "additionalProperties": false,
        "properties": {
          "thread_id": {
            "title": "Thread Id",
            "type": "string"
          },
          "path": {
            "title": "Path",
            "type": "string"
          },
          "line": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Line"
          },
          "start_line": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Start Line"
          },
          "is_resolved": {
            "title": "Is Resolved",
            "type": "boolean"
          },
          "is_outdated": {
            "title": "Is Outdated",
            "type": "boolean"
          },
          "comment_count": {
            "title": "Comment Count",
            "type": "integer"
          },
          "item_pointer": {
            "title": "Item Pointer",
            "type": "string"
          },
          "comments": {
            "items": {
              "$ref": "#/$defs/ThreadCommentManifestItem"
            },
            "title": "Comments",
            "type": "array"
          }
        },
        "required": [
          "thread_id",
          "path",
          "line",
          "start_line",
          "is_resolved",
          "is_outdated",
          "comment_count",
          "item_pointer",
          "comments"
        ],
        "title": "ThreadManifestItem",
        "type": "object"
      }
    },
    "anyOf": [
      {
        "$ref": "#/$defs/GetFeedbackInlineResult"
      },
      {
        "$ref": "#/$defs/GetFeedbackPayloadManifest"
      }
    ]
  }
}
