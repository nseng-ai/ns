{
  "input_json_schema": {
    "additionalProperties": false,
    "properties": {
      "pr_number": {
        "title": "Pr Number",
        "type": "integer"
      },
      "include_resolved": {
        "default": false,
        "title": "Include Resolved",
        "type": "boolean"
      },
      "include_empty_reviews": {
        "default": false,
        "title": "Include Empty Reviews",
        "type": "boolean"
      },
      "payload_mode": {
        "default": "payload",
        "enum": [
          "inline",
          "payload"
        ],
        "title": "Payload Mode",
        "type": "string"
      },
      "payload_session_id": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Payload Session Id"
      }
    },
    "required": [
      "pr_number"
    ],
    "title": "GetFeedbackRequest",
    "type": "object"
  },
  "output_json_schema": {
    "$defs": {
      "BodyLocator": {
        "additionalProperties": false,
        "properties": {
          "body_chars": {
            "title": "Body Chars",
            "type": "integer"
          },
          "json_pointer": {
            "title": "Json Pointer",
            "type": "string"
          },
          "item_pointer": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Item Pointer"
          },
          "domain": {
            "$ref": "#/$defs/FeedbackDomainLocator"
          }
        },
        "required": [
          "body_chars",
          "json_pointer",
          "domain"
        ],
        "title": "BodyLocator",
        "type": "object"
      },
      "DiscussionCommentManifestItem": {
        "additionalProperties": false,
        "properties": {
          "comment_id": {
            "title": "Comment Id",
            "type": "integer"
          },
          "author": {
            "title": "Author",
            "type": "string"
          },
          "url": {
            "title": "Url",
            "type": "string"
          },
          "body_locator": {
            "$ref": "#/$defs/BodyLocator"
          }
        },
        "required": [
          "comment_id",
          "author",
          "url",
          "body_locator"
        ],
        "title": "DiscussionCommentManifestItem",
        "type": "object"
      },
      "FeedbackCounts": {
        "additionalProperties": false,
        "properties": {
          "reviews": {
            "title": "Reviews",
            "type": "integer"
          },
          "review_threads": {
            "title": "Review Threads",
            "type": "integer"
          },
          "unresolved_review_threads": {
            "title": "Unresolved Review Threads",
            "type": "integer"
          },
          "resolved_review_threads": {
            "title": "Resolved Review Threads",
            "type": "integer"
          },
          "thread_comments": {
            "title": "Thread Comments",
            "type": "integer"
          },
          "discussion_comments": {
            "title": "Discussion Comments",
            "type": "integer"
          }
        },
        "required": [
          "reviews",
          "review_threads",
          "unresolved_review_threads",
          "resolved_review_threads",
          "thread_comments",
          "discussion_comments"
        ],
        "title": "FeedbackCounts",
        "type": "object"
      },
      "FeedbackDomainLocator": {
        "additionalProperties": false,
        "properties": {
          "kind": {
            "enum": [
              "review",
              "review_thread_comment",
              "discussion_comment"
            ],
            "title": "Kind",
            "type": "string"
          },
          "review_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Review Id"
          },
          "thread_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Thread Id"
          },
          "comment_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Comment Id"
          },
          "discussion_comment_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Discussion Comment Id"
          },
          "comment_index": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Comment Index"
          },
          "path": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Path"
          },
          "line": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Line"
          },
          "start_line": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Start Line"
          },
          "is_resolved": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Is Resolved"
          },
          "is_outdated": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Is Outdated"
          },
          "author": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Author"
          }
        },
        "required": [
          "kind"
        ],
        "title": "FeedbackDomainLocator",
        "type": "object"
      },
      "GetFeedbackInlineResult": {
        "additionalProperties": false,
        "properties": {
          "payload_mode": {
            "const": "inline",
            "default": "inline",
            "title": "Payload Mode",
            "type": "string"
          },
          "pr_number": {
            "title": "Pr Number",
            "type": "integer"
          },
          "reviews": {
            "items": {
              "$ref": "#/$defs/PRReview"
            },
            "title": "Reviews",
            "type": "array"
          },
          "review_threads": {
            "items": {
              "$ref": "#/$defs/PRReviewThread"
            },
            "title": "Review Threads",
            "type": "array"
          },
          "discussion_comments": {
            "items": {
              "$ref": "#/$defs/PRDiscussionComment"
            },
            "title": "Discussion Comments",
            "type": "array"
          }
        },
        "required": [
          "pr_number",
          "reviews",
          "review_threads",
          "discussion_comments"
        ],
        "title": "GetFeedbackInlineResult",
        "type": "object"
      },
      "GetFeedbackPayloadManifest": {
        "additionalProperties": false,
        "properties": {
          "payload_mode": {
            "const": "payload",
            "default": "payload",
            "title": "Payload Mode",
            "type": "string"
          },
          "payload_reference": {
            "$ref": "#/$defs/PayloadReference"
          },
          "pr_number": {
            "title": "Pr Number",
            "type": "integer"
          },
          "counts": {
            "$ref": "#/$defs/FeedbackCounts"
          },
          "reviews": {
            "items": {
              "$ref": "#/$defs/ReviewManifestItem"
            },
            "title": "Reviews",
            "type": "array"
          },
          "review_threads": {
            "items": {
              "$ref": "#/$defs/ThreadManifestItem"
            },
            "title": "Review Threads",
            "type": "array"
          },
          "discussion_comments": {
            "items": {
              "$ref": "#/$defs/DiscussionCommentManifestItem"
            },
            "title": "Discussion Comments",
            "type": "array"
          }
        },
        "required": [
          "payload_reference",
          "pr_number",
          "counts",
          "reviews",
          "review_threads",
          "discussion_comments"
        ],
        "title": "GetFeedbackPayloadManifest",
        "type": "object"
      },
      "PRDiscussionComment": {
        "description": "A top-level PR discussion comment.",
        "properties": {
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "body": {
            "title": "Body",
            "type": "string"
          },
          "author": {
            "title": "Author",
            "type": "string"
          },
          "url": {
            "title": "Url",
            "type": "string"
          }
        },
        "required": [
          "id",
          "body",
          "author",
          "url"
        ],
        "title": "PRDiscussionComment",
        "type": "object"
      },
      "PRReview": {
        "description": "A PR-level review submission (not an inline thread comment).\n\nRepresents a review submitted via GitHub's \"Review changes\" flow.",
        "properties": {
          "id": {
            "title": "Id",
            "type": "string"
          },
          "author": {
            "title": "Author",
            "type": "string"
          },
          "body": {
            "title": "Body",
            "type": "string"
          },
          "state": {
            "enum": [
              "PENDING",
              "COMMENTED",
              "APPROVED",
              "CHANGES_REQUESTED",
              "DISMISSED"
            ],
            "title": "State",
            "type": "string"
          },
          "submitted_at": {
            "title": "Submitted At",
            "type": "string"
          }
        },
        "required": [
          "id",
          "author",
          "body",
          "state",
          "submitted_at"
        ],
        "title": "PRReview",
        "type": "object"
      },
      "PRReviewComment": {
        "description": "A single comment within a PR review thread.\n\nAttributes:\n    id: Numeric database ID of the comment.\n    body: Markdown body of the comment.\n    author: Author's GitHub login, or empty string if the account was\n        deleted.\n    path: File path the comment is on.\n    line: Line number (None for file-level or outdated comments). When\n        the parent thread covers a multi-line range, this is the *end*\n        of that range; `start_line` is the start. Equals `start_line`\n        for single-line threads (in which case `start_line` is None).\n    start_line: Start of the multi-line range the comment covers, or\n        None for single-line comments. GitHub renders multi-line\n        threads as \"lines +<start_line> to +<line>\".\n    created_at: ISO-8601 timestamp of the comment's creation.",
        "properties": {
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "body": {
            "title": "Body",
            "type": "string"
          },
          "author": {
            "title": "Author",
            "type": "string"
          },
          "path": {
            "title": "Path",
            "type": "string"
          },
          "line": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Line"
          },
          "created_at": {
            "title": "Created At",
            "type": "string"
          },
          "start_line": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Start Line"
          }
        },
        "required": [
          "id",
          "body",
          "author",
          "path",
          "line",
          "created_at"
        ],
        "title": "PRReviewComment",
        "type": "object"
      },
      "PRReviewThread": {
        "description": "A review thread on a PR.\n\nAttributes:\n    id: GraphQL node ID (needed for resolution mutations)\n    path: File path the thread is on\n    line: Line number (None for file-level or outdated comments). When\n        the thread covers a multi-line range, this is the *end* of that\n        range; `start_line` is the start. Equals the thread's sole line\n        for single-line threads (in which case `start_line` is None).\n    start_line: Start of the multi-line range this thread covers, or\n        None for single-line threads. GitHub renders multi-line threads\n        as \"lines +<start_line> to +<line>\".\n    is_resolved: Whether the thread has been resolved\n    is_outdated: Whether the thread is outdated (code changed since comment)\n    comments: Comments in this thread, ordered chronologically",
        "properties": {
          "id": {
            "title": "Id",
            "type": "string"
          },
          "path": {
            "title": "Path",
            "type": "string"
          },
          "line": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Line"
          },
          "is_resolved": {
            "title": "Is Resolved",
            "type": "boolean"
          },
          "is_outdated": {
            "title": "Is Outdated",
            "type": "boolean"
          },
          "comments": {
            "items": {
              "$ref": "#/$defs/PRReviewComment"
            },
            "title": "Comments",
            "type": "array"
          },
          "start_line": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Start Line"
          }
        },
        "required": [
          "id",
          "path",
          "line",
          "is_resolved",
          "is_outdated",
          "comments"
        ],
        "title": "PRReviewThread",
        "type": "object"
      },
      "PayloadReference": {
        "additionalProperties": false,
        "description": "Store-owned facts for a written payload artifact.",
        "properties": {
          "payload_path": {
            "title": "Payload Path",
            "type": "string"
          },
          "session_id": {
            "title": "Session Id",
            "type": "string"
          },
          "descriptor": {
            "title": "Descriptor",
            "type": "string"
          },
          "role": {
            "enum": [
              "raw",
              "summary",
              "log"
            ],
            "title": "Role",
            "type": "string"
          },
          "created_at_utc": {
            "title": "Created At Utc",
            "type": "string"
          },
          "sequence": {
            "title": "Sequence",
            "type": "integer"
          },
          "payload_bytes": {
            "title": "Payload Bytes",
            "type": "integer"
          },
          "content_type": {
            "title": "Content Type",
            "type": "string"
          },
          "extension": {
            "enum": [
              "json",
              "txt"
            ],
            "title": "Extension",
            "type": "string"
          }
        },
        "required": [
          "payload_path",
          "session_id",
          "descriptor",
          "role",
          "created_at_utc",
          "sequence",
          "payload_bytes",
          "content_type",
          "extension"
        ],
        "title": "PayloadReference",
        "type": "object"
      },
      "ReviewManifestItem": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "title": "Id",
            "type": "string"
          },
          "author": {
            "title": "Author",
