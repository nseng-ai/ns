{
  "input_json_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "pr_number": {
        "type": "integer",
        "minimum": -9007199254740991,
        "maximum": 9007199254740991
      },
      "batch_id": {
        "type": "string"
      },
      "commit_sha": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "continue_on_error": {
        "type": "boolean"
      },
      "decisions_file": {
        "type": "string"
      },
      "harness_session_id": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "required": [
      "pr_number",
      "batch_id",
      "decisions_file"
    ],
    "additionalProperties": false
  },
  "output_json_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "valid": {
        "type": "boolean"
      },
      "payload_ready": {
        "type": "boolean"
      },
      "batch_id": {
        "type": "string"
      },
      "commit_sha": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "continue_on_error": {
        "type": "boolean"
      },
      "review_thread_count": {
        "type": "integer",
        "minimum": -9007199254740991,
        "maximum": 9007199254740991
      },
      "resolved_thread_count": {
        "type": "integer",
        "minimum": -9007199254740991,
        "maximum": 9007199254740991
      },
      "skipped_thread_count": {
        "type": "integer",
        "minimum": -9007199254740991,
        "maximum": 9007199254740991
      },
      "ignored_non_thread_items": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "source_kind": {
              "type": "string"
            },
            "review_id": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "discussion_comment_id": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            },
            "summary": {
              "type": "string"
            }
          },
          "required": [
            "source_kind",
            "summary"
          ],
          "additionalProperties": false
        }
      },
      "skipped_items": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "thread_id": {
              "type": "string"
            },
            "skip_reason": {
              "type": "string"
            },
            "summary": {
              "type": "string"
            }
          },
          "required": [
            "thread_id",
            "skip_reason",
            "summary"
          ],
          "additionalProperties": false
        }
      },
      "payload": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "commit_sha": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "continue_on_error": {
                "type": "boolean"
              },
              "items": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "thread_id": {
                      "type": "string"
                    },
                    "mode": {
                      "type": "string",
                      "enum": [
                        "fixed",
                        "pre_existing",
                        "explained",
                        "planned"
                      ]
                    },
                    "message": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "commit_sha": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "provenance": {
                      "anyOf": [
                        {
                          "oneOf": [
                            {
                              "type": "object",
                              "properties": {
                                "kind": {
                                  "type": "string",
                                  "const": "local_branch"
                                },
                                "branch": {
                                  "type": "string"
                                }
                              },
                              "required": [
                                "kind",
                                "branch"
                              ],
                              "additionalProperties": false
                            },
                            {
                              "type": "object",
                              "properties": {
                                "kind": {
                                  "type": "string",
                                  "const": "pr"
                                },
                                "pr_number": {
                                  "type": "integer",
                                  "minimum": -9007199254740991,
                                  "maximum": 9007199254740991
                                }
                              },
                              "required": [
                                "kind",
                                "pr_number"
                              ],
                              "additionalProperties": false
                            }
                          ]
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "required": [
                    "thread_id",
                    "mode"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "items"
            ],
            "additionalProperties": false
          },
          {
            "type": "null"
          }
        ]
      },
      "errors": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            },
            "batch_id": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "thread_id": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "code",
            "message"
          ],
          "additionalProperties": false
        }
      },
      "warnings": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "resolved_inputs": {
        "type": "object",
        "properties": {
          "plan": {
            "type": "object",
            "properties": {
              "payload_path": {
                "type": "string"
              },
              "session_id": {
                "type": "string"
              },
              "descriptor": {
                "type": "string"
              },
              "role": {
                "type": "string",
                "enum": [
                  "raw",
                  "summary",
                  "log"
                ]
              },
              "created_at_utc": {
                "type": "string"
              },
              "sequence": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "payload_bytes": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "content_type": {
                "type": "string"
              },
              "extension": {
                "type": "string",
                "enum": [
                  "json",
                  "txt"
                ]
              }
            },
            "required": [
              "payload_path",
              "session_id",
              "descriptor",
              "role",
              "created_at_utc",
              "sequence",
              "payload_bytes",
              "content_type",
              "extension"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "plan"
        ],
        "additionalProperties": false
      },
      "build_reference": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "payload_path": {
                "type": "string"
              },
              "session_id": {
                "type": "string"
              },
              "descriptor": {
                "type": "string"
              },
              "role": {
                "type": "string",
                "enum": [
                  "raw",
                  "summary",
                  "log"
                ]
              },
              "created_at_utc": {
                "type": "string"
              },
              "sequence": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "payload_bytes": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "content_type": {
                "type": "string"
              },
              "extension": {
                "type": "string",
                "enum": [
                  "json",
                  "txt"
                ]
              }
            },
            "required": [
              "payload_path",
              "session_id",
              "descriptor",
              "role",
              "created_at_utc",
              "sequence",
              "payload_bytes",
              "content_type",
              "extension"
            ],
            "additionalProperties": false
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "required": [
      "valid",
      "payload_ready",
      "batch_id",
      "review_thread_count",
      "resolved_thread_count",
      "skipped_thread_count"
    ],
    "additionalProperties": false
  }
}
