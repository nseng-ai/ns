{
  "input_json_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "prNumber": {
        "type": "integer",
        "minimum": -9007199254740991,
        "maximum": 9007199254740991
      },
      "includeResolved": {
        "type": "boolean"
      },
      "includeAutomation": {
        "type": "boolean"
      },
      "includeEmptyReviews": {
        "type": "boolean"
      }
    },
    "additionalProperties": false
  },
  "output_json_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "found": {
        "type": "boolean"
      },
      "target": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "const": "github_pr"
          },
          "pr_number": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "branch": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "head_ref_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "base_ref_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "kind",
          "pr_number",
          "branch",
          "title",
          "url",
          "head_ref_name",
          "base_ref_name"
        ],
        "additionalProperties": false
      },
      "counts": {
        "type": "object",
        "properties": {
          "included_review_threads": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "included_reviews": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "included_discussion_comments": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "excluded_resolved_threads": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "excluded_empty_reviews": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "excluded_automation_comments": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "included_review_threads",
          "included_reviews",
          "included_discussion_comments",
          "excluded_resolved_threads",
          "excluded_empty_reviews",
          "excluded_automation_comments"
        ],
        "additionalProperties": false
      },
      "markdown": {
        "type": "string"
      }
    },
    "required": [
      "found",
      "target",
      "counts",
      "markdown"
    ],
    "additionalProperties": false
  }
}
