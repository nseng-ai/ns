{
  "input_json_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "from_build": {
        "type": "integer",
        "minimum": -9007199254740991,
        "maximum": 9007199254740991
      },
      "from_build_reference": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "harness_session_id": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "additionalProperties": false
  },
  "output_json_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "total": {
        "type": "integer",
        "minimum": -9007199254740991,
        "maximum": 9007199254740991
      },
      "resolved": {
        "type": "integer",
        "minimum": -9007199254740991,
        "maximum": 9007199254740991
      },
      "failed": {
        "type": "integer",
        "minimum": -9007199254740991,
        "maximum": 9007199254740991
      },
      "skipped": {
        "type": "integer",
        "minimum": -9007199254740991,
        "maximum": 9007199254740991
      },
      "all_succeeded": {
        "type": "boolean"
      },
      "results": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "index": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "thread_id": {
              "type": "string"
            },
            "mode": {
              "type": "string",
              "enum": [
                "fixed",
                "pre_existing",
                "explained",
                "planned"
              ]
            },
            "status": {
              "type": "string",
              "enum": [
                "resolved",
                "failed",
                "skipped"
              ]
            },
            "body": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "comment": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "integer",
                      "minimum": -9007199254740991,
                      "maximum": 9007199254740991
                    },
                    "body": {
                      "type": "string"
                    },
                    "author": {
                      "type": "string"
                    },
                    "path": {
                      "type": "string"
                    },
                    "line": {
                      "anyOf": [
                        {
                          "type": "integer",
                          "minimum": -9007199254740991,
                          "maximum": 9007199254740991
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "created_at": {
                      "type": "string"
                    },
                    "start_line": {
                      "anyOf": [
                        {
                          "type": "integer",
                          "minimum": -9007199254740991,
                          "maximum": 9007199254740991
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "required": [
                    "id",
                    "body",
                    "author",
                    "path",
                    "line",
                    "created_at"
                  ],
                  "additionalProperties": {}
                },
                {
                  "type": "null"
                }
              ]
            },
            "is_resolved": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ]
            },
            "error_type": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "error_message": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "provenance": {
              "anyOf": [
                {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "const": "local_branch"
                        },
                        "branch": {
                          "type": "string"
                        },
                        "branch_head_oid": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "kind",
                        "branch",
                        "branch_head_oid"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "const": "pr"
                        },
                        "pr_number": {
                          "type": "integer",
                          "minimum": -9007199254740991,
                          "maximum": 9007199254740991
                        },
                        "pr_url": {
                          "type": "string"
                        },
                        "pr_state": {
                          "type": "string"
                        },
                        "pr_head_ref_name": {
                          "type": "string"
                        },
                        "pr_head_ref_oid": {
                          "anyOf": [
                            {
                              "type": "string"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        }
                      },
                      "required": [
                        "kind",
                        "pr_number",
                        "pr_url",
                        "pr_state",
                        "pr_head_ref_name"
                      ],
                      "additionalProperties": false
                    }
                  ]
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "index",
            "thread_id",
            "mode",
            "status"
          ],
          "additionalProperties": false
        }
      },
      "resolved_inputs": {
        "type": "object",
        "properties": {
          "resolve_build": {}
        },
        "required": [
          "resolve_build"
        ],
        "additionalProperties": false
      },
      "resolution_reference": {
        "anyOf": [
          {},
          {
            "type": "null"
          }
        ]
      }
    },
    "required": [
      "total",
      "resolved",
      "failed",
      "skipped",
      "all_succeeded",
      "results"
    ],
    "additionalProperties": false
  }
}
