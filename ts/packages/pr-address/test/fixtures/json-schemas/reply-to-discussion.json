{
  "input_json_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "stdout_mode": {
        "type": "string",
        "enum": [
          "full",
          "compact"
        ]
      },
      "pr_number": {
        "type": "integer",
        "minimum": -9007199254740991,
        "maximum": 9007199254740991
      },
      "comment_id": {
        "type": "integer",
        "minimum": -9007199254740991,
        "maximum": 9007199254740991
      },
      "comment_author": {
        "type": "string"
      },
      "original_body": {
        "type": "string"
      },
      "response": {
        "type": "string"
      },
      "harness_session_id": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "required": [
      "pr_number",
      "comment_id",
      "comment_author",
      "original_body",
      "response"
    ],
    "additionalProperties": false
  },
  "output_json_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "anyOf": [
      {
        "type": "object",
        "properties": {
          "body": {
            "type": "string"
          },
          "comment": {
            "type": "object",
            "properties": {
              "id": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "body": {
                "type": "string"
              },
              "author": {
                "type": "string"
              },
              "url": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "body",
              "author",
              "url"
            ],
            "additionalProperties": {}
          },
          "reaction_added": {
            "type": "boolean"
          },
          "reaction": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  "comment_id": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  "content": {
                    "type": "string"
                  }
                },
                "required": [
                  "id",
                  "comment_id",
                  "content"
                ],
                "additionalProperties": {}
              },
              {
                "type": "null"
              }
            ]
          },
          "warning": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "body",
          "comment",
          "reaction_added"
        ],
        "additionalProperties": false
      },
      {
        "type": "object",
        "properties": {
          "operation": {
            "type": "string"
          },
          "counts": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "summary": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "errors": {
            "type": "array",
            "items": {}
          },
          "warnings": {
            "type": "array",
            "items": {}
          },
          "resolved_inputs": {},
          "artifacts": {
            "type": "object",
            "properties": {
              "full_output": {
                "type": "object",
                "properties": {
                  "payload_path": {
                    "type": "string"
                  },
                  "session_id": {
                    "type": "string"
                  },
                  "descriptor": {
                    "type": "string"
                  },
                  "role": {
                    "type": "string",
                    "enum": [
                      "raw",
                      "summary",
                      "log"
                    ]
                  },
                  "created_at_utc": {
                    "type": "string"
                  },
                  "sequence": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  "payload_bytes": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  "content_type": {
                    "type": "string"
                  },
                  "extension": {
                    "type": "string",
                    "enum": [
                      "json",
                      "txt"
                    ]
                  }
                },
                "required": [
                  "payload_path",
                  "session_id",
                  "descriptor",
                  "role",
                  "created_at_utc",
                  "sequence",
                  "payload_bytes",
                  "content_type",
                  "extension"
                ],
                "additionalProperties": false
              },
              "produced": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string"
                    },
                    "reference": {
                      "type": "object",
                      "properties": {
                        "payload_path": {
                          "type": "string"
                        },
                        "session_id": {
                          "type": "string"
                        },
                        "descriptor": {
                          "type": "string"
                        },
                        "role": {
                          "type": "string",
                          "enum": [
                            "raw",
                            "summary",
                            "log"
                          ]
                        },
                        "created_at_utc": {
                          "type": "string"
                        },
                        "sequence": {
                          "type": "integer",
                          "minimum": -9007199254740991,
                          "maximum": 9007199254740991
                        },
                        "payload_bytes": {
                          "type": "integer",
                          "minimum": -9007199254740991,
                          "maximum": 9007199254740991
                        },
                        "content_type": {
                          "type": "string"
                        },
                        "extension": {
                          "type": "string",
                          "enum": [
                            "json",
                            "txt"
                          ]
                        }
                      },
                      "required": [
                        "payload_path",
                        "session_id",
                        "descriptor",
                        "role",
                        "created_at_utc",
                        "sequence",
                        "payload_bytes",
                        "content_type",
                        "extension"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "kind",
                    "reference"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": {}
          },
          "details": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          }
        },
        "required": [
          "operation"
        ],
        "additionalProperties": {}
      }
    ]
  }
}
