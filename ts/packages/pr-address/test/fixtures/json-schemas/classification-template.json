{
  "input_json_schema": {
    "additionalProperties": false,
    "properties": {
      "manifest_json": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Manifest Json"
      },
      "manifest_file": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Manifest File"
      }
    },
    "title": "ClassificationTemplateRequest",
    "type": "object"
  },
  "output_json_schema": {
    "$defs": {
      "ClassificationBodyLocatorRef": {
        "additionalProperties": false,
        "properties": {
          "json_pointer": {
            "title": "Json Pointer",
            "type": "string"
          },
          "item_pointer": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Item Pointer"
          }
        },
        "required": [
          "json_pointer"
        ],
        "title": "ClassificationBodyLocatorRef",
        "type": "object"
      },
      "FeedbackClassificationTemplateCounts": {
        "additionalProperties": false,
        "properties": {
          "reviews": {
            "title": "Reviews",
            "type": "integer"
          },
          "review_threads": {
            "title": "Review Threads",
            "type": "integer"
          },
          "thread_comments": {
            "title": "Thread Comments",
            "type": "integer"
          },
          "discussion_comments": {
            "title": "Discussion Comments",
            "type": "integer"
          },
          "resolved_review_threads_omitted": {
            "title": "Resolved Review Threads Omitted",
            "type": "integer"
          }
        },
        "required": [
          "reviews",
          "review_threads",
          "thread_comments",
          "discussion_comments",
          "resolved_review_threads_omitted"
        ],
        "title": "FeedbackClassificationTemplateCounts",
        "type": "object"
      },
      "FeedbackClassificationTemplateDiscussionCommentItem": {
        "additionalProperties": false,
        "properties": {
          "comment_id": {
            "title": "Comment Id",
            "type": "integer"
          },
          "disposition": {
            "default": "<fill: actionable|informational>",
            "title": "Disposition",
            "type": "string"
          },
          "body_locator": {
            "$ref": "#/$defs/ClassificationBodyLocatorRef"
          },
          "summary": {
            "default": "",
            "title": "Summary",
            "type": "string"
          },
          "action_summary": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Action Summary"
          },
          "complexity": {
            "anyOf": [
              {
                "enum": [
                  "pre_existing",
                  "local",
                  "single_file",
                  "cross_cutting",
                  "complex"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Complexity"
          },
          "needs_reply": {
            "default": false,
            "title": "Needs Reply",
            "type": "boolean"
          },
          "informational_reason": {
            "anyOf": [
              {
                "enum": [
                  "resolved_reference",
                  "automation",
                  "acknowledgement",
                  "approval",
                  "question_only",
                  "fyi",
                  "noise",
                  "already_addressed",
                  "other"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Informational Reason"
          }
        },
        "required": [
          "comment_id",
          "body_locator"
        ],
        "title": "FeedbackClassificationTemplateDiscussionCommentItem",
        "type": "object"
      },
      "FeedbackClassificationTemplatePacket": {
        "additionalProperties": false,
        "properties": {
          "schema_version": {
            "const": 1,
            "default": 1,
            "title": "Schema Version",
            "type": "integer"
          },
          "reviews": {
            "default": [],
            "items": {
              "$ref": "#/$defs/FeedbackClassificationTemplateReviewItem"
            },
            "title": "Reviews",
            "type": "array"
          },
          "review_threads": {
            "default": [],
            "items": {
              "$ref": "#/$defs/FeedbackClassificationTemplateThreadItem"
            },
            "title": "Review Threads",
            "type": "array"
          },
          "discussion_comments": {
            "default": [],
            "items": {
              "$ref": "#/$defs/FeedbackClassificationTemplateDiscussionCommentItem"
            },
            "title": "Discussion Comments",
            "type": "array"
          }
        },
        "title": "FeedbackClassificationTemplatePacket",
        "type": "object"
      },
      "FeedbackClassificationTemplateReviewItem": {
        "additionalProperties": false,
        "properties": {
          "review_id": {
            "title": "Review Id",
            "type": "string"
          },
          "disposition": {
            "default": "<fill: actionable|informational>",
            "title": "Disposition",
            "type": "string"
          },
          "body_locator": {
            "$ref": "#/$defs/ClassificationBodyLocatorRef"
          },
          "summary": {
            "default": "",
            "title": "Summary",
            "type": "string"
          },
          "action_summary": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Action Summary"
          },
          "complexity": {
            "anyOf": [
              {
                "enum": [
                  "pre_existing",
                  "local",
                  "single_file",
                  "cross_cutting",
                  "complex"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Complexity"
          },
          "pre_existing": {
            "default": false,
            "title": "Pre Existing",
            "type": "boolean"
          },
          "informational_reason": {
            "anyOf": [
              {
                "enum": [
                  "resolved_reference",
                  "automation",
                  "acknowledgement",
                  "approval",
                  "question_only",
                  "fyi",
                  "noise",
                  "already_addressed",
                  "other"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Informational Reason"
          }
        },
        "required": [
          "review_id",
          "body_locator"
        ],
        "title": "FeedbackClassificationTemplateReviewItem",
        "type": "object"
      },
      "FeedbackClassificationTemplateThreadCommentRef": {
        "additionalProperties": false,
        "properties": {
          "comment_id": {
            "title": "Comment Id",
            "type": "integer"
          },
          "body_locator": {
            "$ref": "#/$defs/ClassificationBodyLocatorRef"
          }
        },
        "required": [
          "comment_id",
          "body_locator"
        ],
        "title": "FeedbackClassificationTemplateThreadCommentRef",
        "type": "object"
      },
      "FeedbackClassificationTemplateThreadItem": {
        "additionalProperties": false,
        "properties": {
          "thread_id": {
            "title": "Thread Id",
            "type": "string"
          },
          "disposition": {
            "default": "<fill: actionable|informational>",
            "title": "Disposition",
            "type": "string"
          },
          "thread_item_pointer": {
            "title": "Thread Item Pointer",
            "type": "string"
          },
          "covered_comments": {
            "items": {
              "$ref": "#/$defs/FeedbackClassificationTemplateThreadCommentRef"
            },
            "title": "Covered Comments",
            "type": "array"
          },
          "summary": {
            "default": "",
            "title": "Summary",
            "type": "string"
          },
          "action_summary": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Action Summary"
          },
          "complexity": {
            "anyOf": [
              {
                "enum": [
                  "pre_existing",
                  "local",
                  "single_file",
                  "cross_cutting",
                  "complex"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Complexity"
          },
          "pre_existing": {
            "default": false,
            "title": "Pre Existing",
            "type": "boolean"
          },
          "informational_reason": {
            "anyOf": [
              {
                "enum": [
                  "resolved_reference",
                  "automation",
                  "acknowledgement",
                  "approval",
                  "question_only",
                  "fyi",
                  "noise",
                  "already_addressed",
                  "other"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Informational Reason"
          }
        },
        "required": [
          "thread_id",
          "thread_item_pointer",
          "covered_comments"
        ],
        "title": "FeedbackClassificationTemplateThreadItem",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "manifest_kind": {
        "enum": [
          "get_feedback",
          "prepare_run"
        ],
        "title": "Manifest Kind",
        "type": "string"
      },
      "pr_number": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Pr Number"
      },
      "payload_path": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Payload Path"
      },
      "counts": {
        "$ref": "#/$defs/FeedbackClassificationTemplateCounts"
      },
      "classification_template": {
        "$ref": "#/$defs/FeedbackClassificationTemplatePacket"
      }
    },
    "required": [
      "manifest_kind",
      "counts",
      "classification_template"
    ],
    "title": "FeedbackClassificationTemplateResult",
    "type": "object"
  }
}
