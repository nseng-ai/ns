{
	"name": "@nseng-ai/kernel",
	"version": "0.1.2",
	"description": "Emerging customer-facing Source Development Lifecycle CLI.",
	"type": "module",
	"exports": {
		"./cli": "./src/cli/index.ts",
		"./command-io": "./src/runtime/command-io.ts",
		"./context": "./src/cli/context.ts",
		"./pi-text-generation": "./src/runtime/pi-text-generation.ts",
		"./progress-phase-state": "./src/sdk/progress-phase-state.ts",
		"./project-config/points": "./src/project-config/points.ts",
		"./sdk": "./src/sdk/index.ts"
	},
	"ns": {
		"tier": "sdk",
		"subpackages": [
			"cli",
			"extensions",
			"project-config",
			"runtime",
			"sdk"
		],
		"publicPluginApi": [
			"./sdk"
		],
		"internalWorkspaceExports": [
			"./cli",
			"./command-io",
			"./context",
			"./pi-text-generation",
			"./progress-phase-state",
			"./project-config/points"
		]
	},
	"bin": {
		"ns": "./src/cli/index.ts"
	},
	"scripts": {
		"check": "tsgo -p tsconfig.json",
		"test": "cd ../.. && vitest run --config vitest.config.ts packages/kernel/test"
	},
	"dependencies": {
		"@earendil-works/pi-ai": "catalog:",
		"@earendil-works/pi-coding-agent": "catalog:",
		"@nseng-ai/clinkr": "workspace:*",
		"@nseng-ai/foundation": "workspace:*",
		"jiti": "catalog:",
		"smol-toml": "catalog:",
		"zod": "catalog:"
	},
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"src",
		"README.md"
	]
}
