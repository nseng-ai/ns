{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"declaration": true,
		"declarationMap": true,
		"emitDeclarationOnly": false,
		"noEmit": false,
		"outDir": "dist",
		"rootDir": "src",
		"rewriteRelativeImportExtensions": true,
		"sourceMap": true,
		"tsBuildInfoFile": "dist/.tsbuildinfo"
	},
	"include": ["src/**/*.ts"],
	"exclude": ["test", "dist"]
}
