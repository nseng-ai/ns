---
const { siteTitle, siteTitleHref } = Astro.locals.starlightRoute;
---

<a href={siteTitleHref} class="site-title" aria-label={siteTitle} translate="no">
  asdl
</a>

<style>
  @layer starlight.core {
    .site-title {
      display: inline-flex;
      align-items: center;
      color: var(--sl-color-white);
      font-family: var(--__sl-font);
      font-size: 1rem;
      font-weight: 650;
      letter-spacing: -0.04em;
      line-height: 1;
      text-decoration: none;
      white-space: nowrap;
    }

    .site-title:hover {
      color: var(--sl-color-white);
    }
  }
</style>
